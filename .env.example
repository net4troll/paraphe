# ---- Base de données ----
# En local, docker compose publie PostgreSQL sur le port 5433
DATABASE_URL=postgresql://signflow:signflow@localhost:5433/signflow

# ---- Application ----
# Nom affiché de l'application (défaut : Paraphe)
APP_NAME=Paraphe
# URL publique utilisée pour les liens de signature (emails)
APP_URL=http://localhost:3000
# Nom affiché (et inscrit dans le champ "lieu" de la signature)
COMPANY_NAME=Mon Organisation
# Secret JWT pour la session admin (générez : openssl rand -base64 32)
AUTH_SECRET=changez-moi
# Mot de passe d'accès à l'espace admin
ADMIN_PASSWORD=changez-moi
# Email optionnel : notifié à chaque signature reçue
ADMIN_EMAIL=

# ---- Certificat de signature P12 ----
# Généré avec : pnpm cert:generate
SIGN_CERT_PATH=./certs/signing.p12
SIGN_CERT_PASSWORD=
# Sujet du certificat (nom affiché dans Adobe Reader)
SIGN_CERT_SUBJECT=Mon Organisation SARL
# Email de contact inscrit dans la signature
SIGN_CERT_CONTACT=

# ---- Stockage ----
STORAGE_DIR=./storage

# ---- SMTP ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Exemple : "Paraphe <no-reply@mon-domaine.dz>"
MAIL_FROM=
